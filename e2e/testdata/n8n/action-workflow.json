[
  {
    "id": "kura-product-action",
    "name": "Kura Product Action E2E",
    "active": false,
    "settings": {
      "executionOrder": "v1"
    },
    "nodes": [
      {
        "id": "manual",
        "name": "Manual Trigger",
        "type": "n8n-nodes-base.manualTrigger",
        "typeVersion": 1,
        "position": [0, 0],
        "parameters": {}
      },
      {
        "id": "claim",
        "name": "Claim Release",
        "type": "CUSTOM.kura",
        "typeVersion": 2,
        "position": [220, 0],
        "parameters": {
          "resource": "queue",
          "operation": "claim",
          "limit": 1,
          "leaseSeconds": 60
        },
        "credentials": {
          "kuraApi": {
            "id": "kura-product-e2e",
            "name": "Kura Product E2E"
          }
        }
      },
      {
        "id": "submit",
        "name": "Submit Match",
        "type": "CUSTOM.kura",
        "typeVersion": 2,
        "position": [440, 0],
        "parameters": {
          "resource": "queue",
          "operation": "submit",
          "body": "={{ { output: { items: $json.items.map(item => ({ infohash: item.infohash, claimToken: item.claimToken, status: 'matched', ref: 'tvdb:12345', confidence: 1, reason: 'n8n product e2e' })) } } }}"
        },
        "credentials": {
          "kuraApi": {
            "id": "kura-product-e2e",
            "name": "Kura Product E2E"
          }
        }
      },
      {
        "id": "get-release",
        "name": "Get Release",
        "type": "CUSTOM.kura",
        "typeVersion": 2,
        "position": [660, 0],
        "parameters": {
          "resource": "release",
          "operation": "get",
          "infohash": "={{ $json.items[0].infohash }}"
        },
        "credentials": {
          "kuraApi": {
            "id": "kura-product-e2e",
            "name": "Kura Product E2E"
          }
        }
      },
      {
        "id": "update-tags",
        "name": "Update Series Tags",
        "type": "CUSTOM.kura",
        "typeVersion": 2,
        "position": [880, 0],
        "parameters": {
          "resource": "series",
          "operation": "updateTags",
          "ref": "={{ $json.ref }}",
          "tagChanges": "n8n:e2e"
        },
        "credentials": {
          "kuraApi": {
            "id": "kura-product-e2e",
            "name": "Kura Product E2E"
          }
        }
      },
      {
        "id": "show",
        "name": "Show Series",
        "type": "CUSTOM.kura",
        "typeVersion": 2,
        "position": [1100, 0],
        "parameters": {
          "resource": "series",
          "operation": "show",
          "ref": "={{ $json.ref }}",
          "episodes": "ALL",
          "status": [],
          "includeSpecials": false,
          "source": "",
          "resolution": "",
          "simplifyOutput": true,
          "errorOnNotFound": true
        },
        "credentials": {
          "kuraApi": {
            "id": "kura-product-e2e",
            "name": "Kura Product E2E"
          }
        }
      }
    ],
    "connections": {
      "Manual Trigger": {
        "main": [[{ "node": "Claim Release", "type": "main", "index": 0 }]]
      },
      "Claim Release": {
        "main": [[{ "node": "Submit Match", "type": "main", "index": 0 }]]
      },
      "Submit Match": {
        "main": [[{ "node": "Get Release", "type": "main", "index": 0 }]]
      },
      "Get Release": {
        "main": [[{ "node": "Update Series Tags", "type": "main", "index": 0 }]]
      },
      "Update Series Tags": {
        "main": [[{ "node": "Show Series", "type": "main", "index": 0 }]]
      }
    }
  }
]
