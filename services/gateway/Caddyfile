# kura-gateway: one origin for the whole suite — SPA, REST, and MCP.
#
# Reached only from Pomerium, which terminates TLS and owns identity. Nothing
# behind this listener authenticates, so the deployment's NetworkPolicy is what
# keeps anything else from reaching it directly.
#
# Leaf addresses are declared once, as environment variables on the Pod. The
# MCP bridge reads the same two, so the Caddyfile and the bridge cannot desync.
{
	auto_https off
	admin off
	grace_period 10s
	# Per-request metrics collection (caddy_http_*). Exposed on the
	# dedicated :9090 listener below, never on the public origin.
	# Caveat: long-lived MCP streaming GETs land in the same
	# caddy_http_request_duration_seconds histogram as API traffic and
	# inflate its upper percentiles — read MCP latency from the bridge's
	# kura_mcp_tool_duration_seconds instead.
	metrics
}

:8080 {
	# One JSON access-log line per request to stderr, alongside the
	# bridge's logs. Credential-bearing headers — Pomerium's upstream
	# Authorization, cookies, and its identity JWT assertion — are
	# dropped before the line is written; everything else about a
	# request is fair game.
	log {
		output stderr
		format filter {
			wrap json
			fields {
				request>headers>Authorization delete
				request>headers>Cookie delete
				request>headers>X-Pomerium-Jwt-Assertion delete
			}
		}
	}

	# Pomerium's upstream Authorization header is its business, not the
	# leaves'. Strip it rather than forwarding a credential no backend reads.
	request_header -Authorization

	# The suite version is the gateway's, baked from the same ARG that
	# stamps the bridge. `>` replaces rather than appends: the leaves set
	# their own X-Kura-Version and a plain directive would emit both.
	header >X-Kura-Version {$KURA_VERSION}

	# Synthesized health and the MCP surface are served by the in-Pod
	# bridge on loopback, never by a leaf.
	@local path /healthz /api/v1/health
	handle @local {
		reverse_proxy 127.0.0.1:8081
	}

	@mcp path /mcp/v1 /mcp/v1/*
	handle @mcp {
		# `>` replaces: the MCP SDK sets its own Cache-Control, and a plain
		# directive would emit both.
		header >Cache-Control "no-store"
		reverse_proxy 127.0.0.1:8081 {
			# The bridge is intentionally loopback-only. Present its loopback
			# authority instead of the client-facing Service or public Host so
			# the MCP SDK can retain DNS-rebinding protection.
			header_up Host localhost
		}
	}

	# Each leaf owns one stable prefix, so routing needs no enumerated
	# route lists and no ordering between the two services. handle_path
	# is deliberately not used anywhere here — it would strip the prefix
	# the leaves route on.
	@releases path /api/releases/v1 /api/releases/v1/*
	handle @releases {
		reverse_proxy {$KURA_RELEASES_UPSTREAM}
	}

	@library path /api/library/v1 /api/library/v1/*
	handle @library {
		reverse_proxy {$KURA_LIBRARY_UPSTREAM}
	}

	# Anything else under /api is an unknown API path — including the
	# retired bare /api/v1 spellings — and answers in the suite envelope
	# rather than falling through to the SPA's index.html.
	@api path /api /api/*
	handle @api {
		header Content-Type application/json
		respond `{"kind":"not_found","message":"unknown API path"}` 404
	}

	# SPA last: hashed assets as files, everything else to index.html for
	# client-side routing. gzip is scoped to this block — compressing MCP
	# or an event stream would break it.
	handle {
		encode gzip
		root * /srv
		try_files {path} /index.html
		file_server
	}

	# A backend that cannot be reached is the gateway's own failure, so it
	# answers in the suite envelope rather than Caddy's HTML.
	handle_errors {
		@unreachable expression {err.status_code} in [502, 503, 504]
		handle @unreachable {
			header Content-Type application/json
			respond `{"kind":"backend_unavailable","message":"upstream service is unreachable"}` {err.status_code}
		}
		handle {
			header Content-Type application/json
			respond `{"kind":"internal","message":"gateway error"}` {err.status_code}
		}
	}
}

# Prometheus exposition on its own listener, mirroring the leaves: a
# NetworkPolicy that permits a scrape must not also permit API calls.
:9090 {
	metrics /metrics
}
